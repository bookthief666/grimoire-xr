# Copy to .env.local and fill in. Required by the handlers in api/.

# --- Text generation (api/forge.ts, api/oracle.ts) ------------------------
# Required. Without it every forge and oracle request returns 502.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# --- Card art generation (api/card-image*.ts, api/image.ts) ---------------
# ComfyUI backend. Card art is skipped if unset; text generation still works.
COMFYUI_BASE_URL=
COMFYUI_CLIENT_ID=
COMFYUI_CHECKPOINT_DEFAULT=
COMFYUI_CHECKPOINT_EROS=

# Only needed if ComfyUI sits behind Cloudflare Access.
COMFYUI_CF_ACCESS_CLIENT_ID=
COMFYUI_CF_ACCESS_CLIENT_SECRET=

# Fallback image provider.
AI_HORDE_API_KEY=

# --- Local dev ------------------------------------------------------------
# Where vite proxies /api/* during `npm run dev`. Defaults to localhost:3000.
API_PROXY_TARGET=
