# Browser / Capacitor client. Public origin only; never put secrets in VITE_* variables.
# Leave blank for same-origin web deployments.
VITE_API_BASE_URL=

# Server-side text provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-side ComfyUI provider.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CLIENT_ID=grimoire-xr
COMFYUI_CHECKPOINT_DEFAULT=juggernautXL_ragnarokBy.safetensors
# Optional alternate checkpoint for charged/ecstatic/transgressive modes.
COMFYUI_CHECKPOINT_EROS=

# Optional Cloudflare Access service-token headers used only by the server when
# COMFYUI_BASE_URL points at an Access-protected Cloudflare Tunnel hostname.
COMFYUI_CF_ACCESS_CLIENT_ID=
COMFYUI_CF_ACCESS_CLIENT_SECRET=
