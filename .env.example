# Local text generation. These values stay on the Mac and are never bundled into the app.
TEXT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=0
OLLAMA_REQUEST_TIMEOUT_MS=900000

# Local image generation through the existing private ComfyUI installation.
IMAGE_PROVIDER=comfyui
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=juggernautXL_ragnarokBy.safetensors
# Preview preset: measured working Apple-M2 baseline.
COMFYUI_WIDTH=640
COMFYUI_HEIGHT=960
COMFYUI_STEPS=18
# Final preset: higher-quality txt2img render. The client can reuse a preview seed.
COMFYUI_FINAL_WIDTH=832
COMFYUI_FINAL_HEIGHT=1216
COMFYUI_FINAL_STEPS=28
# Refine preset: final-size img2img from an existing ComfyUI output.
COMFYUI_REFINE_DENOISE=0.28
COMFYUI_CFG=4
COMFYUI_SAMPLER=dpmpp_2m
COMFYUI_SCHEDULER=karras
COMFYUI_NEGATIVE_PROMPT="text, watermark, logo, low quality, blurry, malformed hands, extra fingers, duplicate limbs"

# One Metal-intensive job runs at a time. Status polling does not count against rate limits.
AI_QUEUE_MAX=24
AI_PROVIDER_POLL_MS=2000
TEXT_JOB_TTL_MS=1800000
IMAGE_JOB_TTL_MS=1800000
JOB_RESULT_TTL_MS=120000

# Optional Gemini fallbacks. Set the relevant provider to gemini to use these.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

PORT=8787
RATE_LIMIT=120

# Comma-separated web/native origins allowed to call the API server.
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://localhost,capacitor://localhost

# Public HTTPS address for port 8787, embedded into native builds.
# Leave blank during local web development so Vite proxies /api to localhost:8787.
VITE_GRIMOIRE_API_URL=

# Server-only hostnames accepted by `vite preview`, comma separated. Add the
# hostname portion of the current Fold/Quest tunnel here (no https:// or /vr).
# This value is read by vite.config.js and is not included in the browser app.
GRIMOIRE_PREVIEW_ALLOWED_HOSTS=
